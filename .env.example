# Your MongoDB Connection string, same as your bot's.
# For single database setup (legacy):
CONNECTION_URI=mongodb+srv://urihere

# For multiple databases with different paths, use DATABASE_MAPPING instead:
# Format: PATH=MONGO_URI,PATH=MONGO_URI
# Example:
# DATABASE_MAPPING=billow=mongodb+srv://billow_uri,police=mongodb+srv://police_uri,fire=mongodb+srv://fire_uri,emas=mongodb+srv://emas_uri,nh=mongodb+srv://nh_uri

DATABASE_MAPPING=

# Where should the logviewer serve your logs. Default: https://example.com/logs/LOGKEY
LOG_URL_PREFIX=/logs
# Listen address and port. Don't change them if you don't know what they do.
HOST=0.0.0.0
PORT=8000
# Whether if the logviewer should use a proxy to view attachments.
# If set to "no" (default), attachments will expire after 1 day and the logviewer won't be able to show the attachment.
# Please be aware that this may violate Discord TOS and the proxy will have full access to your attachments.
# Modmail/Logviewer is not affiliated with the proxy in any way. USE AT YOUR OWN RISK.
USE_ATTACHMENT_PROXY=no
ATTACHMENT_PROXY_URL=https://cdn.discordapp.xyz

# --- Discord login (optional) ---
# When enabled, only members of the staff server with the staff role can view logs.
DISCORD_AUTH_ENABLED=no
# From the Discord developer portal (OAuth2 tab). Add DISCORD_REDIRECT_URI to the app's redirect list.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://example.com/callback
# Long random string used to sign session cookies, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
SESSION_SECRET=
# Staff server and the role required to view logs.
STAFF_GUILD_ID=1534600320674562159
STAFF_ROLE_ID=1534605889804308581
# Java API that checks staff membership through its Discord bot.
JAVA_API_URL=http://localhost:3000
JAVA_API_KEY=
# How long a login lasts, and how often staff status is re-checked while logged in.
SESSION_MAX_AGE_HOURS=168
STAFF_RECHECK_MINUTES=15
# Set to "no" only when testing over plain http://localhost.
COOKIE_SECURE=yes

# --- Java branding (optional) ---
# Adds the Java logo, a data protection reminder and a link to the policy on every page.
JAVA_BRANDING=no
JAVA_LOGO_URL=https://payhip.com/cdn-cgi/image/format=auto,width=1500/https://pe56d.s3.amazonaws.com/o_1hkesjldmd5bk2917qcavsq0uu.png
JAVA_POLICY_URL=https://docs.google.com/document/d/1BwLS66KzTESwoaGdqKYqJysGHHBW4-jqWvM3920O9yQ/edit?tab=t.0

# --- Ticket dashboard ---
# Logged in staff see recent tickets and a "Done by you" tab on the home page (needs DISCORD_AUTH_ENABLED).
DASHBOARD_PAGE_SIZE=25
